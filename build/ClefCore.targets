<Project>
  <PropertyGroup>
    <_ClefCoreGuardDir>$(MSBuildThisFileDirectory)</_ClefCoreGuardDir>
    <_ClefCoreDotnet>$(DOTNET_HOST_PATH)</_ClefCoreDotnet>
    <_ClefCoreDotnet Condition="'$(_ClefCoreDotnet)' == ''">dotnet</_ClefCoreDotnet>
  </PropertyGroup>

  <Target Name="CheckClefCoreNominals" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_ClefCoreInput>$(IntermediateOutputPath)ClefCore.compile.tsv</_ClefCoreInput>
    </PropertyGroup>
    <ItemGroup>
      <_ClefCoreDefine Include="$(DefineConstants)" />
    </ItemGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(_ClefCoreInput)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="P&#x9;$(MSBuildProjectDirectory);@(_ClefCoreDefine->'D&#x9;%(Identity)');@(Compile->'F&#x9;%(FullPath)&#x9;%(Identity)&#x9;%(Link)')" />
    <Exec Command="&quot;$(_ClefCoreDotnet)&quot; fsi --nologo --quiet --reference:&quot;$(MSBuildToolsPath)/FSharp/FSharp.Compiler.Service.dll&quot; &quot;$(_ClefCoreGuardDir)../tools/ClefCoreGuard.fsx&quot; check &quot;$(_ClefCoreInput)&quot; &quot;$(_ClefCoreGuardDir)ClefCore.allowances.tsv&quot;" />
  </Target>
</Project>
