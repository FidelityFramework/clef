<?xml version="1.0" encoding="utf-8"?>
<!--
  FSharp.DependencyManager.Nuget - NuGet dependency resolution for FSI

  Provides #r directive resolution for F# Interactive.
  Required by FNCS for script/interactive scenarios.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>FSharp.DependencyManager.Nuget</AssemblyName>
    <DefineConstants>$(DefineConstants);COMPILER</DefineConstants>
    <Tailcalls>true</Tailcalls>
    <!-- Disable nullable for legacy code - these files predate nullable annotations -->
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);3261</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <NoOptimizationData>true</NoOptimizationData>
    <NoInterfaceData>false</NoInterfaceData>
    <CompressMetadata>true</CompressMetadata>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(RepoRoot)src/Compiler/Utilities/NullnessShims.fs" Link="NullnessShims.fs" />
    <EmbeddedText Include="FSDependencyManager.txt" />
    <EmbeddedText Include="$(RepoRoot)src/Compiler/Facilities/UtilsStrings.txt" Link="UtilsStrings.txt" />
    <Compile Include="$(RepoRoot)src/Compiler/Facilities/CompilerLocation.fsi" Link="CompilerLocation.fsi" />
    <Compile Include="$(RepoRoot)src/Compiler/Facilities/CompilerLocation.fs" Link="CompilerLocation.fs" />
    <Compile Include="FSharp.DependencyManager.ProjectFile.fs" />
    <Compile Include="FSharp.DependencyManager.Utilities.fs" />
    <Compile Include="FSharp.DependencyManager.fsi" />
    <Compile Include="FSharp.DependencyManager.fs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FSharp.Compiler.Private.Scripting.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="9.0.100" />
    <PackageReference Include="System.Reflection.Metadata" Version="8.0.0" />
  </ItemGroup>

</Project>
