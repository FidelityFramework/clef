<?xml version="1.0" encoding="utf-8"?>
<!--
  FSharp.Native.Compiler.Service - F# Native Compiler Services

  FNCS provides F# parsing and type checking for native compilation.
  This is a simplified, Arcade-free build for the Fidelity bridge period.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target net10.0 with FSharp.Core 10.x -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>FSharp.Native.Compiler.Service</AssemblyName>

    <!-- Warnings -->
    <NoWarn>$(NoWarn);44;57;75;1204;NU5125;64</NoWarn>

    <!-- Compiler settings -->
    <!-- FNCS Native Compilation Defines:
         - NO_INLINE_IL_PARSER: Inline IL parsing not supported in native compilation
         - NO_TYPEPROVIDERS: Type providers require BCL reflection (Assembly.UnsafeLoadFrom, Activator.CreateInstance)
           Type providers are fundamentally incompatible with native compilation because they:
           1. Load assemblies at compile time via reflection
           2. Invoke provider methods via System.Type reflection
           3. Use null patterns (MaybeNull) tied to BCL nullable semantics
           The codebase already has #if !NO_TYPEPROVIDERS guards throughout.
           Metaprogramming capability may be restored via native-first approach in future.
         - NO_IL_ASSEMBLY_IMPORT: IL assembly metadata reading not needed for native compilation.
           Native compilation uses Alloy source directly - types come from F# source parsing,
           not from reading .NET assembly IL metadata. The ILTypeMetadata code paths are disabled.
           This affects: import.fs, TypeHierarchy.fs, infos.fs, and related IL metadata reading. -->
    <DefineConstants>$(DefineConstants);COMPILER;NO_INLINE_IL_PARSER;NO_TYPEPROVIDERS;NO_IL_ASSEMBLY_IMPORT</DefineConstants>
    <Nullable>enable</Nullable>
    <OtherFlags>$(OtherFlags) --extraoptimizationloops:1</OtherFlags>
    <OtherFlags>$(OtherFlags) --warnon:3218</OtherFlags>
    <OtherFlags>$(OtherFlags) --warnon:3390</OtherFlags>
    <OtherFlags>$(OtherFlags) --generate-filter-blocks</OtherFlags>
    <Tailcalls>true</Tailcalls>

    <!-- FsLex/FsYacc output folders -->
    <!-- Pre-generated parser files are in source tree per target framework -->
    <FsYaccOutputFolder>$(MSBuildProjectDirectory)/$(TargetFramework)/</FsYaccOutputFolder>
    <FsLexOutputFolder>$(MSBuildProjectDirectory)/$(TargetFramework)/</FsLexOutputFolder>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <!-- NuGet Package Configuration -->
  <PropertyGroup>
    <PackageId>FSharp.Native.Compiler.Service</PackageId>
    <IsPackable>true</IsPackable>
    <PackageDescription>F# Native Compiler Services - F# parsing and type checking for native compilation via Firefly.</PackageDescription>
    <PackageTags>F#;fsharp;compiler;native;fidelity</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/speakez-llc/fsnative</PackageProjectUrl>
    <RepositoryUrl>https://github.com/speakez-llc/fsnative</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Version is set in Directory.Build.props -->
  </PropertyGroup>

  <!-- Internals visible for Firefly and testing -->
  <ItemGroup>
    <InternalsVisibleTo Include="FSharp.Native.Compiler.Service.Tests" />
    <InternalsVisibleTo Include="Firefly" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Utilities\NullnessShims.fs" />
    <EmbeddedText Include="FSComp.txt">
      <Link>FSComp.txt</Link>
    </EmbeddedText>
    <EmbeddedText Include="Interactive\FSIstrings.txt">
      <Link>FSIstrings.txt</Link>
    </EmbeddedText>
    <EmbeddedResource Include="FSStrings.resx">
      <Link>FSStrings.resx</Link>
      <LogicalName>FSStrings.resources</LogicalName>
    </EmbeddedResource>
    <Compile Include="Utilities\Activity.fsi" />
    <Compile Include="Utilities\Activity.fs" />
	<Compile Include="Utilities\Caches.fsi" />
    <Compile Include="Utilities\Caches.fs" />
    <Compile Include="Utilities\illib.fsi" />
    <Compile Include="Utilities\illib.fs" />
    <Compile Include="Utilities\sformat.fsi" />
    <Compile Include="Utilities\sformat.fs" />
    <Compile Include="Utilities\sr.fsi" />
    <Compile Include="Utilities\sr.fs" />
    <Compile Include="Utilities\ResizeArray.fsi" />
    <Compile Include="Utilities\ResizeArray.fs" />
    <Compile Include="Utilities\HashMultiMap.fsi" />
    <Compile Include="Utilities\HashMultiMap.fs" />
    <Compile Include="Utilities\EditDistance.fsi" />
    <Compile Include="Utilities\EditDistance.fs" />
    <Compile Include="Utilities\TaggedCollections.fsi" />
    <Compile Include="Utilities\TaggedCollections.fs" />
    <Compile Include="Utilities\Cancellable.fsi" />
    <Compile Include="Utilities\Cancellable.fs" />
    <Compile Include="Utilities\FileSystem.fsi" />
    <Compile Include="Utilities\FileSystem.fs" />
    <Compile Include="Utilities\ildiag.fsi" />
    <Compile Include="Utilities\ildiag.fs" />
    <Compile Include="Utilities\zmap.fsi" />
    <Compile Include="Utilities\zmap.fs" />
    <Compile Include="Utilities\zset.fsi" />
    <Compile Include="Utilities\zset.fs" />
    <Compile Include="Utilities\XmlAdapters.fsi" />
    <Compile Include="Utilities\XmlAdapters.fs" />
    <Compile Include="Utilities\InternalCollections.fsi" />
    <Compile Include="Utilities\InternalCollections.fs" />
    <Compile Include="Utilities\QueueList.fsi" />
    <Compile Include="Utilities\QueueList.fs" />
    <Compile Include="Utilities\lib.fsi" />
    <Compile Include="Utilities\lib.fs" />
    <Compile Include="Utilities\DependencyGraph.fs" />
    <Compile Include="Utilities\LruCache.fsi" />
    <Compile Include="Utilities\LruCache.fs" />
    <Compile Include="Utilities\ImmutableArray.fsi" />
    <Compile Include="Utilities\ImmutableArray.fs" />
    <Compile Include="Utilities\rational.fsi" />
    <Compile Include="Utilities\rational.fs" />
    <Compile Include="Utilities\PathMap.fsi" />
    <Compile Include="Utilities\PathMap.fs" />
    <Compile Include="Utilities\RidHelpers.fs" />
    <Compile Include="Utilities\range.fsi" />
    <Compile Include="Utilities\range.fs" />
    <EmbeddedText Include="Facilities\UtilsStrings.txt" />
    <Compile Include="Facilities\LanguageFeatures.fsi" />
    <Compile Include="Facilities\LanguageFeatures.fs" />
    <Compile Include="Facilities\DiagnosticOptions.fsi" />
    <Compile Include="Facilities\DiagnosticOptions.fs" />
    <Compile Include="Facilities\TextLayoutRender.fsi" />
    <Compile Include="Facilities\TextLayoutRender.fs" />
    <Compile Include="Facilities\DiagnosticsLogger.fsi" />
    <Compile Include="Facilities\DiagnosticsLogger.fs" />
    <Compile Include="Facilities\DiagnosticResolutionHints.fsi" />
    <Compile Include="Facilities\DiagnosticResolutionHints.fs" />
    <Compile Include="Facilities\Hashing.fsi" />
    <Compile Include="Facilities\Hashing.fs" />
    <Compile Include="Facilities\prim-lexing.fsi" />
    <Compile Include="Facilities\prim-lexing.fs" />
    <Compile Include="Facilities\prim-parsing.fsi" />
    <Compile Include="Facilities\prim-parsing.fs" />
    <Compile Include="Facilities\ReferenceResolver.fsi" />
    <Compile Include="Facilities\ReferenceResolver.fs" />
    <!-- SimulatedMSBuildReferenceResolver removed - not needed for native compilation -->
    <Compile Include="Facilities\CompilerLocation.fsi" />
    <Compile Include="Facilities\CompilerLocation.fs" />
    <Compile Include="Facilities\BuildGraph.fsi" />
    <Compile Include="Facilities\BuildGraph.fs" />
    <Compile Include="Facilities\AsyncMemoize.fsi" />
    <Compile Include="Facilities\AsyncMemoize.fs" />
    <Compile Include="Utilities\ReadOnlySpan.fsi" />
    <Compile Include="Utilities\ReadOnlySpan.fs" />
    <Compile Include="SyntaxTree\PrettyNaming.fsi" />
    <Compile Include="SyntaxTree\PrettyNaming.fs" />
    <FsLex Include="pplex.fsl">
      <OtherFlags>--module FSharp.Native.Compiler.PPLexer --internal --open FSharp.Native.Compiler.Lexhelp --open Internal.Utilities.Text.Lexing --open FSharp.Native.Compiler.PPParser --unicode --lexlib Internal.Utilities.Text.Lexing</OtherFlags>
      <Link>SyntaxTree\pplex.fsl</Link>
    </FsLex>
    <FsYacc Include="pppars.fsy">
      <OtherFlags>--module FSharp.Native.Compiler.PPParser --open FSharp.Native.Compiler.ParseHelpers --open FSharp.Native.Compiler.LexerStore --internal --lexlib Internal.Utilities.Text.Lexing --parslib Internal.Utilities.Text.Parsing --buffer-type-argument char</OtherFlags>
      <Link>SyntaxTree\pppars.fsy</Link>
    </FsYacc>
    <FsLex Include="lex.fsl">
      <OtherFlags>--module FSharp.Native.Compiler.Lexer --open FSharp.Native.Compiler.Lexhelp --open Internal.Utilities.Text.Lexing --open FSharp.Native.Compiler.Parser --open FSharp.Native.Compiler.Text --open FSharp.Native.Compiler.ParseHelpers --open FSharp.Native.Compiler.LexerStore --internal --unicode --lexlib Internal.Utilities.Text.Lexing</OtherFlags>
      <Link>SyntaxTree\lex.fsl</Link>
    </FsLex>
    <FsYacc Include="pars.fsy">
      <OtherFlags>--module FSharp.Native.Compiler.Parser --open FSharp.Native.Compiler --open FSharp.Native.Compiler.Syntax --open FSharp.Native.Compiler.Text --internal --lexlib Internal.Utilities.Text.Lexing --parslib Internal.Utilities.Text.Parsing --buffer-type-argument char</OtherFlags>
      <Link>SyntaxTree\pars.fsy</Link>
    </FsYacc>
    <None Include="pplex.fsl">
      <Link>SyntaxTree\FsLex\pplex.fsl</Link>
    </None>
    <None Include="lex.fsl">
      <Link>SyntaxTree\FsLex\lex.fsl</Link>
    </None>
    <None Include="pppars.fsy">
      <Link>SyntaxTree\FsYacc\pppars.fsy</Link>
    </None>
    <None Include="pars.fsy">
      <Link>SyntaxTree\FsYacc\pars.fsy</Link>
    </None>
    <Compile Include="SyntaxTree\UnicodeLexing.fsi" />
    <Compile Include="SyntaxTree\UnicodeLexing.fs" />
    <Compile Include="SyntaxTree\XmlDoc.fsi" />
    <Compile Include="SyntaxTree\XmlDoc.fs" />
    <Compile Include="SyntaxTree\SyntaxTrivia.fsi" />
    <Compile Include="SyntaxTree\SyntaxTrivia.fs" />
    <Compile Include="SyntaxTree\SyntaxTree.fsi" />
    <Compile Include="SyntaxTree\SyntaxTree.fs" />
    <Compile Include="SyntaxTree\SyntaxTreeOps.fsi" />
    <Compile Include="SyntaxTree\SyntaxTreeOps.fs" />
    <Compile Include="SyntaxTree\WarnScopes.fsi" />
    <Compile Include="SyntaxTree\WarnScopes.fs" />
    <Compile Include="SyntaxTree\LexerStore.fsi" />
    <Compile Include="SyntaxTree\LexerStore.fs" />
    <Compile Include="SyntaxTree\ParseHelpers.fsi" />
    <Compile Include="SyntaxTree\ParseHelpers.fs" />
    <Compile Include="$(FsYaccOutputFolder)pppars.fsi">
      <Link>SyntaxTree\FsYaccOutput\pppars.fsi</Link>
    </Compile>
    <Compile Include="$(FsYaccOutputFolder)pppars.fs">
      <Link>SyntaxTree\FsYaccOutput\pppars.fs</Link>
    </Compile>
    <Compile Include="$(FsYaccOutputFolder)pars.fsi">
      <Link>SyntaxTree\FsYaccOutput\pars.fsi</Link>
    </Compile>
    <Compile Include="$(FsYaccOutputFolder)pars.fs">
      <Link>SyntaxTree\FsYaccOutput\pars.fs</Link>
    </Compile>
    <Compile Include="SyntaxTree\LexHelpers.fsi">
      <Link>SyntaxTree\LexHelpers.fsi</Link>
    </Compile>
    <Compile Include="SyntaxTree\LexHelpers.fs">
      <Link>SyntaxTree\LexHelpers.fs</Link>
    </Compile>
    <Compile Include="$(FsYaccOutputFolder)pplex.fsi">
      <Link>SyntaxTree\FsLexOutput\pplex.fsi</Link>
    </Compile>
    <Compile Include="$(FsYaccOutputFolder)pplex.fs">
      <Link>SyntaxTree\FsLexOutput\pplex.fs</Link>
    </Compile>
    <Compile Include="$(FsYaccOutputFolder)\lex.fsi">
      <Link>SyntaxTree\FsLexOutput\lex.fsi</Link>
    </Compile>
    <Compile Include="$(FsYaccOutputFolder)\lex.fs">
      <Link>SyntaxTree\FsLexOutput\lex.fs</Link>
    </Compile>
    <Compile Include="SyntaxTree\LexFilter.fsi" />
    <Compile Include="SyntaxTree\LexFilter.fs" />
    <!-- Native types - foundational types for native compilation, needed by TypedTree and tainted -->
    <Compile Include="NativeTypedTree\NativeTypes.fs" />
    <Compile Include="TypedTree\tainted.fsi" />
    <Compile Include="TypedTree\tainted.fs" />
    <Compile Include="TypedTree\TypeProviders.fsi" />
    <Compile Include="TypedTree\TypeProviders.fs" />
    <Compile Include="TypedTree\QuotationPickler.fsi" />
    <Compile Include="TypedTree\QuotationPickler.fs" />
    <Compile Include="TypedTree\CompilerGlobalState.fsi" />
    <Compile Include="TypedTree\CompilerGlobalState.fs" />
    <Compile Include="TypedTree\TypedTree.fsi" />
    <Compile Include="TypedTree\TypedTree.fs" />
    <Compile Include="TypedTree\TypedTreeBasics.fsi" />
    <Compile Include="TypedTree\TypedTreeBasics.fs" />
    <Compile Include="TypedTree\TcGlobals.fsi" />
    <Compile Include="TypedTree\TcGlobals.fs" />
    <Compile Include="TypedTree\TypedTreeOps.fsi" />
    <Compile Include="TypedTree\TypedTreeOps.fs" />
    <!-- TypedTreePickle.fsi/fs REMOVED - BCL machinery for .NET assembly metadata, not needed for native compilation -->
    <Compile Include="TypedTree\UpdatePrettyTyparNames.fsi" />
    <Compile Include="TypedTree\UpdatePrettyTyparNames.fs" />
    <Compile Include="Utilities\TypeHashing.fs" />
    <!-- import.fsi/fs REMOVED - "Functions to import .NET binary metadata as TAST objects" - BCL cruft -->
    <!-- TypeHierarchy.fsi/fs REMOVED - Type hierarchy via ImportMap indirection layer -->
    <!-- infos.fsi/fs REMOVED - MethInfo/PropInfo/EventInfo unification layer for IL+F# - pure indirection for native -->
    <!-- AccessibilityLogic.fsi/fs REMOVED - IL+F# accessibility unification, entangled with infos types -->
    <!-- InfoReader.fsi/fs REMOVED - Reads Info types to select members, depends on removed modules -->
    <!-- AttributeChecking.fsi/fs REMOVED - Attribute checking on IL-unified member types -->
    <!-- TypeRelations.fsi/fs REMOVED - Type subsumption via ImportMap -->
    <!-- NicePrint.fsi/fs REMOVED - Pretty printing via IL-unified member types -->
    <!-- AugmentWithHashCompare.fsi/fs REMOVED - Hash/Equals augmentation (Import.ImportMap dependency) -->
    <!-- NameResolution.fsi/fs REMOVED - Name resolution via InfoReader -->
    <!-- SignatureConformance.fsi/fs REMOVED - InfoReader dependency -->
    <!-- MethodOverrides.fsi/fs REMOVED - InfoReader, NameResolution, Infos dependencies -->
    <!-- MethodCalls.fsi/fs REMOVED - Method resolution via InfoReader, NameResolution, Infos -->
    <!-- PatternMatchCompilation.fsi/fs REMOVED - InfoReader dependency -->
    <!-- ConstraintSolver.fsi/fs REMOVED - Core of type inference, depends on InfoReader, MethodCalls, Infos -->
    <!--
    OLD CHECKING FOLDER REMOVED - All type-checking depended on IL indirection layer.
    The native type checker is being rebuilt from scratch without IL/BCL dependencies.
    See NativeTypedTree/ for the new native-first type checking implementation.
    -->

    <!-- PSGSaturation - Program Semantic Graph with saturation passes -->
    <!-- FNCS's responsibility: make the PSG semantically complete -->
    <!-- SemanticGraph split into focused nanopass modules (January 2026) -->
    <Compile Include="PSGSaturation\SemanticGraph\SeqSaturation.fs" />
    <Compile Include="PSGSaturation\SemanticGraph\Types.fs" />
    <Compile Include="PSGSaturation\SemanticGraph\Core.fs" />
    <Compile Include="PSGSaturation\SemanticGraph\Builder.fs" />
    <Compile Include="PSGSaturation\SemanticGraph\Reachability.fs" />
    <Compile Include="PSGSaturation\SemanticGraph\Traversal.fs" />
    <Compile Include="PSGSaturation\SemanticGraph\Diagnostics.fs" />

    <!-- NativeTypedTree - Native Type Checker (BCL-free, unified representation) -->
    <!-- NativeTypes.fs moved earlier - foundational types needed by TypedTree -->
    <Compile Include="NativeTypedTree\NativeGlobals.fs" />
    <Compile Include="NativeTypedTree\UnionFind.fs" />
    <Compile Include="NativeTypedTree\Unify.fs" />
    <Compile Include="NativeTypedTree\NameResolution.fs" />
    <!-- Expressions - Modular expression checking -->
    <!-- Handler modules (no circular dependencies - use callback pattern) -->
    <Compile Include="NativeTypedTree\Expressions\Types.fs" />
    <Compile Include="NativeTypedTree\Expressions\Literals.fs" />
    <Compile Include="NativeTypedTree\Expressions\Intrinsics.fs" />
    <Compile Include="NativeTypedTree\Expressions\Identity.fs" />
    <Compile Include="NativeTypedTree\Expressions\SynTypes.fs" />
    <Compile Include="NativeTypedTree\Expressions\Patterns.fs" />
    <Compile Include="NativeTypedTree\Expressions\ControlFlow.fs" />
    <Compile Include="NativeTypedTree\Expressions\TypeOperations.fs" />
    <Compile Include="NativeTypedTree\Expressions\Collections.fs" />
    <Compile Include="NativeTypedTree\Expressions\Applications.fs" />
    <Compile Include="NativeTypedTree\Expressions\Bindings.fs" />
    <!-- Coordinator - Thin dispatcher that ties modules together -->
    <Compile Include="NativeTypedTree\Expressions\Coordinator.fs" />
    <Compile Include="NativeTypedTree\SRTPResolution.fs" />
    <Compile Include="NativeTypedTree\FSharpNativeExpr.fs" />
    <!-- Infrastructure - Nanopass phase configuration and intermediate emission -->
    <Compile Include="NativeTypedTree\Infrastructure\PhaseConfig.fs" />
    <Compile Include="NativeTypedTree\Infrastructure\PhaseTypes.fs" />
    <Compile Include="NativeTypedTree\Infrastructure\PhaseEmitter.fs" />
    <!-- Baker - Post-construction semantic enrichment (peer to NativeTypedTree) -->
    <Compile Include="Baker\Metadata.fs" />
    <Compile Include="Baker\ShadowAST.fs" />
    <Compile Include="Baker\ModuleInit.fs" />
    <Compile Include="Baker\Pipeline.fs" />
    <!-- Baker Ingredients - Combinator primitives and patterns (PRD-13a) -->
    <Compile Include="Baker\Ingredients\RecipeBuilder.fs" />
    <Compile Include="Baker\Ingredients\Primitives.fs" />
    <Compile Include="Baker\Ingredients\Patterns.fs" />
    <!-- Baker Recipes - HOF decomposition templates (PRD-13a) -->
    <Compile Include="Baker\Recipes\Decomposition.fs" />
    <Compile Include="Baker\Recipes\ListRecipes.fs" />
    <Compile Include="Baker\Recipes\MapRecipes.fs" />
    <Compile Include="Baker\Recipes\SetRecipes.fs" />
    <Compile Include="Baker\Recipes\OptionRecipes.fs" />
    <Compile Include="Baker\Recipes\SeqRecipes.fs" />
    <Compile Include="Baker\HOFDecomposition.fs" />

    <Compile Include="NativeTypedTree\NativeService.fs" />

    <!-- Project - Unified project loading and checking (DRY - single source of truth) -->
    <Compile Include="Project\FidprojLoader.fs" />
    <Compile Include="Project\SourceResolver.fs" />
    <Compile Include="Project\ProjectChecker.fs" />

    <!-- Optimize.fs removed - IL optimization not applicable to native compilation.
         Semantic optimizations (inlining, SRTP resolution, monomorphization) are performed
         by FNCS and Firefly in the semantic layer. MLIR/LLVM are deterministic carriers
         that implement what Fidelity dictates. Fidelity controls memory layout - not MLIR. -->
    <!-- CodeGen removed - FNCS uses Alex for code generation to MLIR -->
    <!-- FxResolver removed - .NET Framework resolution not needed -->
    <Compile Include="DependencyManager/AssemblyResolveHandler.fsi">
      <Link>Driver\AssemblyResolveHandler.fsi</Link>
    </Compile>
    <Compile Include="DependencyManager/AssemblyResolveHandler.fs">
      <Link>Driver\AssemblyResolveHandler.fs</Link>
    </Compile>
    <Compile Include="DependencyManager/NativeDllResolveHandler.fsi">
      <Link>Driver\NativeDllResolveHandler.fsi</Link>
    </Compile>
    <Compile Include="DependencyManager/NativeDllResolveHandler.fs">
      <Link>Driver\NativeDllResolveHandler.fs</Link>
    </Compile>
    <Compile Include="DependencyManager/DependencyProvider.fsi">
      <Link>Driver\DependencyProvider.fsi</Link>
    </Compile>
    <Compile Include="DependencyManager/DependencyProvider.fs">
      <Link>Driver\DependencyProvider.fs</Link>
    </Compile>
    <!-- CompilerConfig removed - BCL-dependent, no longer referenced -->
    <!-- CompilerImports removed - .NET assembly imports not needed for native -->
    <!-- CompilerDiagnostics removed - depends on deleted type checking modules -->
    <Compile Include="Driver\GraphChecking\Continuation.fsi" />
    <Compile Include="Driver\GraphChecking\Continuation.fs" />
    <Compile Include="Driver\GraphChecking\Types.fsi" />
    <Compile Include="Driver\GraphChecking\Types.fs" />
    <Compile Include="Driver\GraphChecking\Graph.fsi" />
    <Compile Include="Driver\GraphChecking\Graph.fs" />
    <Compile Include="Driver\GraphChecking\TrieMapping.fsi" />
    <Compile Include="Driver\GraphChecking\TrieMapping.fs" />
    <Compile Include="Driver\GraphChecking\FileContentMapping.fsi" />
    <Compile Include="Driver\GraphChecking\FileContentMapping.fs" />
    <Compile Include="Driver\GraphChecking\DependencyResolution.fsi" />
    <Compile Include="Driver\GraphChecking\DependencyResolution.fs" />
    <Compile Include="Driver\GraphChecking\GraphProcessing.fsi" />
    <Compile Include="Driver\GraphChecking\GraphProcessing.fs" />
    <Content Include="Driver\GraphChecking\Docs.md" />
    <!-- ParseAndCheckInputs removed - old type checking orchestration -->
    <!-- ScriptClosure removed - script handling for FSI not needed -->
    <!-- CompilerOptions removed - depends on deleted Optimizer -->
    <!-- OptimizeInputs, BinaryResourceFormats, StaticLinking, CreateILModule removed - IL generation not needed -->
    <Compile Include="Driver\XmlDocFileWriter.fsi" />
    <Compile Include="Driver\XmlDocFileWriter.fs" />
    <!-- fsc.fs removed - old driver, will be replaced with native driver -->

    <!-- Symbols API removed - depends on deleted type checking infrastructure -->

    <!-- Service API removed - depends on deleted type checking infrastructure -->
    <!-- Interactive (FSI) removed - not needed for native compilation -->
    <!-- Legacy removed -->
  </ItemGroup>

  <!--
    FsLex/FsYacc Tool Integration

    The parser generator tools (fslex, fsyacc) must be built before this project.
    Tool paths are set in Directory.Build.props/targets.
    Build order: buildtools/fslex -> buildtools/fsyacc -> src/Compiler
  -->
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)buildtools/fslex/fslex.fsproj" ReferenceOutputAssembly="false">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="$(RepoRoot)buildtools/fsyacc/fsyacc.fsproj" ReferenceOutputAssembly="false">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- Package Dependencies -->
  <ItemGroup>
    <!-- Core F# runtime -->
    <PackageReference Include="FSharp.Core" Version="10.0.101" />

  </ItemGroup>

  <!--
    FSharp.DependencyManager.Nuget - Required for #r directive resolution in FSI.
    This is a project reference since we maintain it in fsnative.
  -->
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src/FSharp.DependencyManager.Nuget/FSharp.DependencyManager.Nuget.fsproj" />
  </ItemGroup>

  <!-- Fidelity.Toml - TOML parser for .fidproj loading -->
  <ItemGroup>
    <ProjectReference Include="../../../Fidelity.Toml/src/Fidelity.Toml.fsproj" />
  </ItemGroup>

</Project>
