<Project>
  <!--
    FNCS Directory Build Targets - Arcade-free

    Minimal targets for F# Native Compiler Services.
  -->

  <Import Project="FSharpBuild.Directory.Build.targets" />

  <!-- FsLex/FsYacc tool paths -->
  <PropertyGroup>
    <FsLexPath>$(ArtifactsDir)bin/fslex/$(Configuration)/net9.0/fslex.dll</FsLexPath>
    <FsYaccPath>$(ArtifactsDir)bin/fsyacc/$(Configuration)/net9.0/fsyacc.dll</FsYaccPath>
  </PropertyGroup>

</Project>
